<odoo>
    <record id="view_payment_provider_form_cloudpayments" model="ir.ui.view">
        <field name="name">payment.provider.form.cloudpayments</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'cloudpayments'">
                    <field name="cloudpayments_public_id" required="code == 'cloudpayments' and state != 'disabled'"/>
                    <field name="cloudpayments_secret_key" required="code == 'cloudpayments' and state != 'disabled'" password="True"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
